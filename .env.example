# ==============================================================================
# Mocking Engine & State Simulator - Environment Variables Template
# ==============================================================================
# Copia este archivo como .env y define tus valores locales:
#   cp .env.example .env
# NUNCA subas el archivo .env a Git.
# ==============================================================================

# Clave secreta para firma criptográfica de tokens JWT (HS256)
# Debe ser una cadena Base64 con un mínimo de 256 bits (32 bytes).
# Generación en consola: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256_bit_secret_key_here_minimum_32_bytes==

# Tiempo de expiración del token JWT en milisegundos (86400000 ms = 24 horas)
JWT_EXPIRATION_MS=86400000

# Base de datos relacional PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mockengine_db
SPRING_DATASOURCE_USERNAME=mockengine_user
SPRING_DATASOURCE_PASSWORD=mockengine_password
